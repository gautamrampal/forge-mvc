                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<username>\",\n  \"status\": \"<status>\",\n  \"password\": \"<password>\"\n}"
            }
          }
        },
        {
          "name": "Delete users",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "id of the record"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}