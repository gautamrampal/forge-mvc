NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
APP_NAME=Forge MVC

# mvc  = server-rendered EJS views + session auth (traditional web app)
# api  = JSON only, no views, JWT auth
# hybrid = both web/* and api/* route trees mounted side by side (default, recommended)
APP_MODE=hybrid

# View engine for the MVC tree: ejs (app/views/*.ejs) or tsx (app/views-tsx/*.tsx, React SSR)
VIEW_ENGINE=ejs

SESSION_SECRET=change_this_dev_secret
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=7d

# --- Sessions (web route tree only) ------------------------------------------
# Where sessions live — same idea as Laravel's SESSION_DRIVER. One of:
#   db        = persistent store in whatever DB_DRIVER points at (default; zero extra infra)
#   file      = one JSON file per session under SESSION_FILE_DIR (single node only)
#   sqlite    = single SQLite file; transactional, no lost-update race (npm install connect-sqlite3)
#   redis     = shared across instances — the right choice when you run more than one node
#   memcached = shared across instances (npm install connect-memcached)
#   cookie    = whole session in the signed cookie: zero server storage, but ~4KB cap, payload
#               readable by the user, no server-side revoke ("log out everywhere" impossible),
#               and expiry enforced only by the browser — a captured cookie stays valid
#   memory    = in-process; lost on restart, never shared — local dev only
# NODE_ENV=test always forces memory (except cookie) so the test runner can exit cleanly.
SESSION_STORE=db
# SESSION_STORE=file: directory for the session files (created automatically)
SESSION_FILE_DIR=./storage/sessions
# SESSION_STORE=sqlite: path to the database file (directory is created automatically)
SESSION_SQLITE_FILE=./storage/sessions.sqlite
# SESSION_STORE=redis
REDIS_URL=redis://127.0.0.1:6379
# SESSION_STORE=memcached: comma-separated host:port list
MEMCACHED_HOSTS=127.0.0.1:11211

# --- Database ---------------------------------------------------------------
# One of: mysql | postgres | mongodb
DB_DRIVER=mysql

# mysql / postgres
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=forge_mvc

# mongodb (used only when DB_DRIVER=mongodb)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=forge_mvc

# Test-run database names. Default to <DB_NAME>_test / <MONGO_DB_NAME>_test — override if
# another project on this machine already uses that name (tests truncate tables freely).
# TEST_DB_NAME=
# TEST_MONGO_DB_NAME=

# Playwright E2E run (npm run test:e2e). The browser suite uses its own database and port so it
# can never collide with the unit/integration run above. tests/e2e/global-setup.js creates the
# database, applies migrations and seeds the account the specs log in as.
# E2E_DB_NAME=forge_mvc_e2e
# E2E_PORT=5099
# E2E_USERNAME=e2e
# E2E_PASSWORD=E2E@12345

# --- Mail ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Forge MVC" <no-reply@example.com>

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=D:/projects/forge-mvc/storage/uploads
MAX_FILE_SIZE_MB=10

# --- Service / SOA ----------------------------------------------------------
# Identifies this service in logs and health responses when you run more than one.
SERVICE_NAME=forge-mvc
SERVICE_VERSION=1.0.0
LOG_LEVEL=

# Graceful shutdown (see core/lifecycle.js)
# PRE_STOP_DELAY_MS: fail readiness, then wait this long before closing, so the load balancer
# has time to poll /ready and stop routing here. Set to ~2x your probe interval.
PRE_STOP_DELAY_MS=5000
SHUTDOWN_TIMEOUT_MS=15000
# Must exceed your load balancer's idle timeout, or you get random 502s on reused sockets.
KEEP_ALIVE_TIMEOUT_MS=65000
READY_CHECK_TIMEOUT_MS=2000

# CORS. Empty = off (same-origin only). Comma-separated allowlist, or * for a public read API.
# "*" cannot be combined with CORS_CREDENTIALS=true — the app refuses to boot if you try.
CORS_ORIGINS=
CORS_CREDENTIALS=false

# Rate limiting. NOTE: the default store is per-process memory — with N instances the effective
# limit is N x RATE_LIMIT_MAX. Use a shared store (redis) for real enforcement.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Downstream services (see app/services/notificationService.js)
NOTIFICATION_SERVICE_URL=http://localhost:5020
NOTIFICATION_TIMEOUT_MS=3000
