<%
  // One form serves both create and edit — the presence of record.id decides which.
  const isEdit = Boolean(record.id);
%>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><%= title %></h4>
  <a href="/users" class="btn btn-sm btn-outline-secondary">Back to list</a>
</div>

<div class="card" style="max-width: 560px;"><div class="card-body">
  <form method="POST" action="<%= isEdit ? '/users/' + record.id : '/users' %>" novalidate>
    <!-- Every state-changing form needs this, or core/middlewares/csrf.js rejects the request. -->
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <!-- HTML forms can only GET or POST; core/Application.js reads this and rewrites the verb. -->
    <% if (isEdit) { %><input type="hidden" name="_method" value="PUT"><% } %>

    <div class="mb-3">
      <label class="form-label" for="username">Username *</label>
      <input type="text" id="username" name="username"
             class="form-control <%= formErrors.username ? 'is-invalid' : '' %>"
             value="<%= record.username || '' %>" required minlength="3" maxlength="50" autofocus>
      <% if (formErrors.username) { %>
        <div class="invalid-feedback d-block"><%= formErrors.username %></div>
      <% } %>
      <div class="form-text">Letters, numbers, dots, underscores and hyphens.</div>
    </div>

    <div class="mb-3">
      <label class="form-label" for="password">
        Password <%= isEdit ? '' : '*' %>
      </label>
      <input type="password" id="password" name="password"
             class="form-control <%= formErrors.password ? 'is-invalid' : '' %>"
             <%= isEdit ? '' : 'required' %> minlength="8" autocomplete="new-password">
      <% if (formErrors.password) { %>
        <div class="invalid-feedback d-block"><%= formErrors.password %></div>
      <% } %>
      <div class="form-text">
        <%= isEdit ? 'Leave blank to keep the current password.' : 'At least 8 characters.' %>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label" for="status">Status *</label>
      <select id="status" name="status" class="form-select <%= formErrors.status ? 'is-invalid' : '' %>">
        <option value="active" <%= (record.status || 'active') === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= record.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
      <% if (formErrors.status) { %>
        <div class="invalid-feedback d-block"><%= formErrors.status %></div>
      <% } %>
      <div class="form-text">Inactive users cannot sign in, and are signed out on their next request.</div>
    </div>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save changes' : 'Create user' %></button>
      <a href="/users" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div></div>
