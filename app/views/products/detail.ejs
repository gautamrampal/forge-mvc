<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h4 class="mb-0"><%= record.name %></h4>
  <div class="d-flex gap-2">
    <a href="/products/<%= record.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
    <!-- Delete is a FORM, not a link: a GET must never change state. CSRF exempts safe methods,
         and any crawler or link prefetcher would fire it. See TUTORIAL-SECURITY.md section 11. -->
    <form method="POST" action="/products/<%= record.id %>"
          onsubmit="return confirm('Delete this product?')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
    </form>
  </div>
</div>

<div class="card"><div class="card-body">
  <dl class="row mb-0">
    <dt class="col-sm-3">SKU</dt>
    <dd class="col-sm-9"><code><%= record.sku %></code></dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">
      ₹<%= record.price %>
      <span class="text-muted small">(<%= record.price_paise %> paise)</span>
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
      <span class="badge bg-<%= record.status === 'active' ? 'success' : 'secondary' %>"><%= record.status %></span>
    </dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9"><%= record.description || '—' %></dd>

    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9 text-muted"><%= record.created_at %></dd>

    <dt class="col-sm-3">Updated</dt>
    <dd class="col-sm-9 text-muted"><%= record.updated_at %></dd>
  </dl>
</div></div>

<a href="/products" class="btn btn-link mt-3 px-0">&larr; Back to products</a>
