<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h4 class="mb-0">Products</h4>
  <a href="/products/create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Product</a>
</div>

<!-- GET so results stay linkable and the back button works; no CSRF needed, it changes nothing. -->
<form method="GET" action="/products" class="row g-2 mb-3">
  <div class="col-12 col-sm-5 col-md-4">
    <input type="search" name="q" class="form-control form-control-sm"
           placeholder="Search SKU or name…" value="<%= q %>">
  </div>
  <div class="col-auto">
    <select name="status" class="form-select form-select-sm">
      <option value="">All statuses</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive</option>
    </select>
  </div>
  <div class="col-auto">
    <select name="sort" class="form-select form-select-sm">
      <option value="">Newest first</option>
      <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name A–Z</option>
      <option value="price" <%= sort === 'price' ? 'selected' : '' %>>Price high–low</option>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
  </div>
  <% if (q || status || sort) { %>
    <div class="col-auto"><a href="/products" class="btn btn-sm btn-outline-secondary">Clear</a></div>
  <% } %>
</form>

<% if (!rows.length) { %>
  <!-- Two different empty states: "nothing matched" is a dead end, "nothing yet" is an invitation. -->
  <div class="card"><div class="card-body text-center text-muted py-5">
    <% if (q || status) { %>
      <p>No products match that filter.</p>
      <a href="/products" class="btn btn-outline-secondary btn-sm">Clear filters</a>
    <% } else { %>
      <p>No products yet.</p>
      <a href="/products/create" class="btn btn-primary btn-sm">Create your first product</a>
    <% } %>
  </div></div>
<% } else { %>
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead class="table-light">
        <tr><th>SKU</th><th>Name</th><th class="text-end">Price</th><th>Status</th><th>Created</th><th></th></tr>
      </thead>
      <tbody>
        <% rows.forEach(function (record) { %>
          <tr>
            <td><a href="/products/<%= record.id %>"><code><%= record.sku %></code></a></td>
            <td><%= record.name %></td>
            <td class="text-end">₹<%= record.price %></td>
            <td>
              <span class="badge bg-<%= record.status === 'active' ? 'success' : 'secondary' %>">
                <%= record.status %>
              </span>
            </td>
            <td class="small text-muted"><%= record.created_at %></td>
            <td class="text-end">
              <a href="/products/<%= record.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<p class="text-muted small mt-2">Page <%= page %> of <%= totalPages %> (<%= total %> total)</p>
<% } %>
