<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height:100vh; background:#0f172a;">
  <div class="w-100" style="max-width:400px;">
    <h4 class="text-center text-white mb-3"><%= appName %></h4>
    <div class="card border-0 shadow-lg">
      <div class="card-body p-4">
        <h5 class="mb-3"><%= title %></h5>
        <% ['success','error','info'].forEach(function(kind){ %>
          <% (messages[kind] || []).forEach(function(msg){ %>
            <div class="alert alert-<%= kind === 'error' ? 'danger' : (kind === 'success' ? 'success' : 'info') %>"><%= msg %></div>
          <% }); %>
        <% }); %>
        <%- body %>
      </div>
    </div>
  </div>
</body>
</html>
